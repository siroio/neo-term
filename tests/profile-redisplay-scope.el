;;; profile-redisplay-scope.el --- Compare terminal buffer layouts -*- lexical-binding: t; -*-
;; Diagnostic only; run in a disposable GUI Emacs with -Q.
(defconst neo-term-scope-root
  (expand-file-name "../" (file-name-directory load-file-name)))
(load (expand-file-name "neo-term.el" neo-term-scope-root) nil t)
(defvar neo-term-scope-results nil)

(defun neo-term-scope-case (kind)
  (let ((buffer (generate-new-buffer " *terminal scope*")) samples)
    (unwind-protect
        (progn
          (switch-to-buffer buffer)
          (neo-term-mode)
          (cancel-timer neo-term--cursor-timer)
          (setq neo-term--cursor-blink nil)
          (redisplay t)
          (let* ((cols 80) (height 32)
                 (cells (vconcat (cl-loop repeat cols collect [" " 1 -1 -1 0])))
                 (rows (vconcat (cl-loop for row below height
                                        collect (vector row (copy-sequence cells))))))
            (aset (aref (aref rows 0) 1) 10 ["a" 1 -1 -1 0])
            (neo-term--screen `((cols . ,cols) (height . ,height) (x . 11) (y . 0)
                                (visible . t) (cursor_blink . nil) (rows . ,rows)))
            (neo-term--render)
            (when (timerp neo-term--timer) (cancel-timer neo-term--timer))
            (setq neo-term--timer nil)
            (let ((inhibit-read-only t) (neo-term--updating t))
              (when (eq kind 'trimmed)
                (save-excursion
                  (goto-char (point-min))
                  (while (re-search-forward " +$" nil t)
                    (delete-region (match-beginning 0) (match-end 0)))))
              (when (eq kind 'plain)
                (set-text-properties (point-min) (point-max) nil)
                (buffer-face-mode -1)))
            (goto-char (+ (point-min) 11))
            (redisplay t)
            (dotimes (index 220)
              (let ((inhibit-read-only t) (neo-term--updating t)
                    (start (+ (point-min) 10)))
                (if (memq kind '(render guarded-width guarded-window restore-modified local-redisplay))
                    (let ((new (copy-sequence (aref neo-term--lines 0))))
                      (aset new 10 (vector (if (cl-evenp index) "a" "b") 1 -1 -1 0))
                      (aset neo-term--lines 0 new)
                      (pcase kind
                        ((or 'restore-modified 'local-redisplay)
                         (let ((original (symbol-function 'set-window-start)))
                           (cl-letf (((symbol-function 'set-buffer-modified-p)
                                      #'restore-buffer-modified-p)
                                     ((symbol-function 'set-window-start)
                                      (lambda (window position &optional noforce)
                                        (unless (and (eq kind 'local-redisplay)
                                                     (= (window-start window) position))
                                          (funcall original window position noforce)))))
                             (neo-term--render))))
                        ('guarded-width
                         (let ((original (symbol-function 'set-char-table-range)))
                           (cl-letf (((symbol-function 'set-char-table-range)
                                      (lambda (table range value)
                                        (unless (and (integerp range) (equal (aref table range) value))
                                          (funcall original table range value)))))
                             (neo-term--render))))
                        ('guarded-window
                         (let ((original (symbol-function 'set-window-start)))
                           (cl-letf (((symbol-function 'set-window-start)
                                      (lambda (window position &optional noforce)
                                        (unless (= (window-start window) position)
                                          (funcall original window position noforce)))))
                             (neo-term--render))))
                        (_ (neo-term--render))))
                  ;; Same protected cell edit without terminal bookkeeping.
                  (goto-char start)
                  (let ((props (text-properties-at start)))
                    (delete-region start (1+ start))
                    (insert (apply #'propertize (if (cl-evenp index) "a" "b") props)))
                  (goto-char (+ start 1))
                  (set-buffer-modified-p nil))
                (let ((time (float-time)))
                  (redisplay t)
                  (when (>= index 20)
                    (push (* 1000 (- (float-time) time)) samples)))))
            (setq samples (sort samples #'<))
            (push (format "kind=%s size=%sx%s chars=%s median=%.4fms min=%.4fms max=%.4fms\n"
                          kind cols height (buffer-size)
                          (/ (+ (nth 99 samples) (nth 100 samples)) 2)
                          (car samples) (car (last samples))) neo-term-scope-results)))
      (kill-buffer buffer))))

(condition-case failure
    (progn
      (unless (display-graphic-p) (error "GUI Emacs required"))
      (set-frame-size nil 80 35)
      (when (getenv "NEO_TERM_SCOPE_NO_DWRITE")
        (setq w32-inhibit-dwrite t)
        (clear-font-cache))
      (dotimes (trial 3)
        (dolist (kind (if (getenv "NEO_TERM_SCOPE_FOCUSED")
                         (if (cl-evenp trial)
                             '(render restore-modified guarded-window local-redisplay)
                           '(local-redisplay guarded-window restore-modified render))
                       (if (cl-evenp trial)
                           '(render direct trimmed plain guarded-width guarded-window)
                         '(guarded-window guarded-width plain trimmed direct render))))
          (neo-term-scope-case kind)))
      (with-temp-file (expand-file-name "build/redisplay-scope.log" neo-term-scope-root)
        (insert (format "Emacs=%s dwrite-inhibited=%S\n" emacs-version w32-inhibit-dwrite))
        (dolist (entry (nreverse neo-term-scope-results)) (insert entry)))
      (kill-emacs 0))
  (error
   (with-temp-file (expand-file-name "build/redisplay-scope.log" neo-term-scope-root)
     (insert (format "FAIL=%S" failure)))
   (kill-emacs 1)))
