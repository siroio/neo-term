;;; profile-input-layout.el --- Diagnose unused terminal glyphs -*- lexical-binding: t; -*-
;; Diagnostic only: hiding padding is not a supported terminal representation.
(defconst neo-term-input-layout-root
  (expand-file-name "../" (file-name-directory load-file-name)))
(load (or (getenv "NEO_TERM_BENCH_SOURCE")
          (expand-file-name "neo-term.el" neo-term-input-layout-root)) nil t)
(defvar neo-term-input-layout-hidden 0)
(defvar neo-term-input-layout-tail nil)

(when (and (or (getenv "NEO_TERM_BENCH_COMPACT") (getenv "NEO_TERM_BENCH_HIDE_PADDING"))
           (fboundp 'neo-term--row-count))
  (error "Use pre-compaction Lisp with these historical layout probes"))

(defun neo-term-input-layout-compact (function &rest args)
  "Temporarily restore the full model, then omit default blank tails for display."
  (let ((inhibit-read-only t) (neo-term--updating t) changed)
    (dotimes (row neo-term--height)
      (when (or (/= (length neo-term--rendered-lines) neo-term--height)
                (not (equal (aref neo-term--lines row)
                            (aref neo-term--rendered-lines row)))
                (= row (cdr neo-term--cursor)))
        (push row changed)))
    (dolist (row (if (/= (length neo-term--rendered-lines) neo-term--height)
                    (number-sequence 0 (1- (length neo-term--row-markers))) changed))
      (when (< row (length neo-term--row-markers))
        (goto-char (aref neo-term--row-markers row))
        (let* ((begin (point))
               (expected (cl-loop for cell across (or (aref neo-term--rendered-lines row) [])
                                  sum (length (aref cell 0))))
               (padding (- expected (- (line-end-position) begin))))
          (goto-char (line-end-position))
          (when (> padding 0)
            (insert (propertize (make-string padding ?\s)
                                'read-only t 'front-sticky '(read-only))))
          (set-marker (aref neo-term--row-markers row) begin))))
    (when (> (length neo-term--row-markers) 0)
      (set-marker neo-term--screen-start (aref neo-term--row-markers 0)))
    (prog1 (apply function args)
      ;; A layout rebuild can recreate unchanged blank rows as well.
      (dotimes (row neo-term--height)
        (goto-char (aref neo-term--row-markers row))
        (let* ((begin (point)) (end (line-end-position)) (tail end)
               (limit (if (= row (cdr neo-term--cursor))
                          (min end (1+ (neo-term--cursor-position))) begin)))
          (while (and (> tail limit) (= (char-before tail) ?\s)
                      (not (get-text-property (1- tail) 'face))
                      (not (get-text-property (1- tail) 'display)))
            (cl-decf tail))
          (delete-region tail end)
          (cl-incf neo-term-input-layout-hidden (- end tail))))
      (goto-char (neo-term--cursor-position)))))

(defun neo-term-input-layout-hide-padding (function &rest args)
  (let (changed)
    (dotimes (row neo-term--height)
      (when (or (/= (length neo-term--rendered-lines) neo-term--height)
                (not (equal (aref neo-term--lines row)
                            (aref neo-term--rendered-lines row)))
                (= row (cdr neo-term--cursor)))
        (push row changed)))
    (prog1 (apply function args)
      (let ((inhibit-read-only t) (neo-term--updating t))
        (dolist (row changed)
          (let* ((begin (marker-position (aref neo-term--row-markers row)))
                 (end (save-excursion (goto-char begin) (line-end-position)))
                 (tail end)
                 (limit (if (= row (cdr neo-term--cursor))
                            (min end (1+ (neo-term--cursor-position))) begin)))
            (when (> end begin)
              (setq neo-term-input-layout-tail (text-properties-at (1- end))))
            (while (and (> tail limit) (= (char-before tail) ?\s)
                        (not (get-text-property (1- tail) 'face))
                        (not (get-text-property (1- tail) 'display)))
              (cl-decf tail))
            (neo-term--set-property-changes begin tail 'invisible nil)
            (neo-term--set-property-changes tail end 'invisible t)
            (cl-incf neo-term-input-layout-hidden (- end tail))))))))

(when (getenv "NEO_TERM_BENCH_HIDE_PADDING")
  (advice-add 'neo-term--render :around #'neo-term-input-layout-hide-padding))
(when (getenv "NEO_TERM_BENCH_COMPACT")
  (advice-add 'neo-term--render :around #'neo-term-input-layout-compact))
(add-hook 'kill-emacs-hook
          (lambda ()
            (with-temp-file (expand-file-name "build/input-layout-state.log" neo-term-input-layout-root)
              (insert (format "hidden-cell-visits=%s tail-properties=%S\n"
                              neo-term-input-layout-hidden neo-term-input-layout-tail)))))
(load (expand-file-name "tests/benchmark-input.el" neo-term-input-layout-root) nil t)
